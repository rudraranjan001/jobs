# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/jobportal?retryWrites=true&w=majority

# JWT Secret Key (any random strong string)
SECRET_KEY=your_secret_key_here

# Cloudinary Credentials (from Cloudinary Dashboard)
CLOUD_NAME=your_cloud_name
API_KEY=your_api_key
API_SECRET=your_api_secret

# Server Port
PORT=8000

# Frontend URL (set this after deploying frontend on Vercel)
FRONTEND_URL=http://localhost:5173
